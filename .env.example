# Copia este archivo como .env y completa los valores.
# NUNCA subas .env al repositorio.

# Entorno: development | production
NODE_ENV=development

# Puerto del servidor (en desarrollo Vite usa 5173 aparte)
PORT=3001

# Ruta del archivo SQLite. Relativa a la raíz del proyecto o absoluta.
DATABASE_PATH=./data/skinbyyulieth.db

# Carpeta de copias de seguridad automáticas.
BACKUP_DIR=./backups

# Días que se conservan las copias automáticas.
BACKUP_RETENTION_DAYS=30

# Minutos entre copias automáticas (1440 = una vez al día).
BACKUP_INTERVAL_MINUTES=1440

# Origen público de la aplicación, usado para cookies/seguridad.
# En desarrollo con Vite: http://localhost:5173
# En producción: https://tu-dominio.com
APP_ORIGIN=http://localhost:5173

# Secreto de sesión (mínimo 32 caracteres aleatorios).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Días de validez de la sesión.
SESSION_DAYS=30

# Cookies seguras: poner true en producción con HTTPS.
COOKIE_SECURE=false

# Límite en MB para comprobantes de gastos.
MAX_RECEIPT_MB=5

# Opcional: confiar en el proxy inverso para IP y protocolo.
# Se activa automáticamente en producción.
# TRUST_PROXY=true

# Opcional: carpeta del frontend compilado.
# CLIENT_DIR=./dist/client
